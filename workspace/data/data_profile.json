 "key_findings": {
  "F1_list_field_semantics": {
   "finding": "8 个列表型指标是分类器 logits，非分数",
   "evidence": "ad_en/fluency_en 两位相关 -0.985/-0.980（成对二分类）；modernbert_* 为 6 类有序 logits，softmax 期望类别对 fineweb_edu 相关 +0.30~+0.33，而取均值为 -0.09~-0.24（符号相反）",
   "consequence": "标量化必须用 logit 差（二分类）与 softmax 期望类别（有序），取均值会自我抵消",
   "source": "workspace/data/list_semantics.json"
  },
  "F2_domain_confound": {
   "finding": "25 个候选标量中 15 个近乎完美分离 arxiv 与 github",
   "evidence": "|AUC-0.5|>0.45 的有 15 个；最高 modernbert_reasoning AUC=0.9957；qurater 的 arxiv p05=2.15 高于 github p95=1.33",
   "consequence": "合并总体归一化会让 Q 退化为域标签；分位数/Min-Max 必须按域计算",
   "source": "workspace/data/domain_confound.json"
  },
  "F3_domain_mass_imbalance": {
   "finding": "github 占合并样本 78.44%",
   "evidence": "github 213752 / arxiv 18942 / c4,stackexchange,wikipedia 各 10000 / commoncrawl 9640 / book 171，总计 272505",
   "consequence": "域级聚合须用稳健均值 + bootstrap；book 域仅 171 条，其域级 Q 不确定性远大于其他域",
   "source": "workspace/data/quantile_population.json"
  },
  "F4_a16_mapping_mostly_empty": {
   "finding": "A16 中 11/17 个配方域的目标质量域为空",
   "evidence": "direct 3（arxiv/github/stackexchange）、near_direct 3（wikipedia/book/commoncrawl）、inferred 11 全部 (none)",
   "consequence": "即便决定把 Q 引入配比模型，也只有 6/17 维有 Q 可用；质量侧 c4 域在配方侧无来源，两体系部分不相交",
   "source": "workspace/data/profile_a_mixture.json"
  },
  "F5_mixture_zeros": {
   "finding": "配方表极稀疏，ILR 不可直接用",
   "evidence": "train_1m 512 行中 511 行含精确零，共 3928 个零，每行中位约 8/17 个域为零；6 对表 index 全部严格对齐；行和偏离 1 最大 0.004",
   "consequence": "ILR/CLR 的对数比在每行中位 8 个零上不成立，伪计数会主导坐标",
   "source": "workspace/data/profile_a_mixture.json"
  },
  "F6_zero_vs_noloss_domains": {
   "finding": "4 个无 Loss 列域零值率最高，但非严格对应",
   "evidence": "enron_emails 68.8%、philpapers 59.8%、nih_exporter 58.0% 居前三，但第四名 hackernews 52.5% 有 Loss 列；europarl 51.6% 第五",
   "consequence": "强相关而非等价；处理这 4 列时须同时考虑其低配比属性",
   "source": "workspace/data/profile_a_mixture.json"
  },
  "F7_unit_consistency_confirmed": {
   "finding": "C_FLOPs_1e21 与 6ND 的中位比值恰为 1.0000",
   "evidence": "B1 n=1176 中位 1.0000（范围 0.766-1.763）；B2 n=1029 中位 1.0000（范围 0.989-1.024）",
   "consequence": "C=6ND 口径可用；B2 的极窄散布进一步印证其半合成性质",
   "source": "workspace/data/profile_b_scaling.json"
  },
  "F8_Q_is_design_variable": {
   "finding": "B6/B7/B8 是完全因子设计网格，Q_score 为设计因子非测量值",
   "evidence": "B6=9x5x8=360 完整；B7=9x5x10=450 完整；B8=15x10x12=1800 实 1704（缺 96 格）；Q_score 仅取 8/10/12 个整数刻度值",
   "consequence": "Q1 的经验 Q（连续、受域混淆）与 B6-B8 的网格 Q 不是同类对象，不能靠线性缩放对齐。此为 Q2 首要探针",
   "source": "workspace/data/profile_b_scaling.json"
  },
  "F9_bridge_high_tier_tiny": {
   "finding": "桥接高可比样本仅 7 条",
   "evidence": "C5 43 行（High 7 / Medium 36）；C6 75 行（High 7 / Medium 68）；扩展仅增加 Medium 层",
   "consequence": "Loss-Benchmark 映射实际建立在 7 个可靠点上，映射误差须作为独立随机项传播",
   "source": "workspace/data/profile_c_leaderboard.json"
  },
  "F10_loss_benchmark_sign": {
   "finding": "Loss 与 Benchmark 均分负相关，符合题设方向",
   "evidence": "C5 全样本 r=-0.5015；C6 r=-0.5100；High 层 r=-0.3975（n=7）；Medium 层 r=-0.49~-0.50",
   "consequence": "方向正确；High 层相关反而弱于 Medium，样本量太小所致，不可据此认为 High 层质量更差",
   "source": "workspace/data/profile_c_leaderboard.json"
  },
  "F11_short_time_window": {
   "finding": "Q4 的密集时间窗口远短于预测窗口",
   "evidence": "C1 跨度 2024-06-08 至 2025-03-13 共 278 天（9.1 个月）；C3 名义 2019-2025，但 2024 年前仅 24 行（2019:1, 2020:1, 2021:2, 2022:7, 2023:13），2024-2025 为 4575 行",
   "consequence": "用约 15 个月密集数据外推 12-24 个月，不确定性必然很宽；须报区间而非点值",
   "source": "workspace/data/profile_c_leaderboard.json"
  },
  "F12_pretrained_subsample_small": {
